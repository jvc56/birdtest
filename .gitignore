# Rust
/backend/target/
# Node
node_modules/
/frontend/.svelte-kit/
/frontend/build/
# Python
__pycache__/
*.pyc
.venv/
*.egg-info/
# Env
.env
.env.local
# Terraform
.terraform/
*.tfstate
*.tfstate.*
# The stack's variables (README.md, "Deploying"): account-specific.
*.tfvars

# Local snapshots taken by scripts/dev-dump.sh
.dev-backups/

# Per-contributor working directories made by scripts/dev.py: each holds a
# contribute.txt (with the worker identity the server assigned it), the
# settings.txt MAGPIE writes, a log, and a symlink to the data directory.
/.dev-workers/
/.e2e-worker/

# A contribute.txt left at the root by a local `magpie contribute` run.
/contribute.txt

# A personal launch checklist, not part of the repository.
/LAUNCH_PLAN.md

# The Terraform backend: names this account's state bucket (LAUNCH_PLAN.md, Step 5).
/infra/backend.tf
/infra/magpie/backend.tf
/infra/magpie/*.plan
