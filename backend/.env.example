# Local development configuration. In ECS these same variables are supplied by
# the task definition, which pulls the secret-valued ones from SSM Parameter
# Store — the process itself only ever reads the environment.

# Either a full DATABASE_URL, or DB_HOST / DB_PORT / DB_NAME / DB_USER /
# DB_PASSWORD (and optionally DB_SSLMODE), which are assembled with the password
# percent-encoded. The parts exist so a deployment can inject a managed,
# rotating password on its own.
DATABASE_URL=postgres://birdtest:birdtest@localhost:5432/birdtest
BIND_ADDR=0.0.0.0:8080

# 32 bytes, hex-encoded. This is a throwaway dev value committed on purpose;
# every real environment gets its own from SSM.
SESSION_SIGNING_KEY=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff
SESSION_TTL_SECONDS=604800
# Cookies are only marked Secure behind TLS; local dev is plain HTTP.
SECURE_COOKIES=false

# console: confirmation codes and reset links are logged to stdout instead of
# being emailed. There is no local SES, and a real mail sink is not worth
# standing up for dev. Set to `ses` (with AWS credentials) to test that path.
MAIL_BACKEND=console
MAIL_FROM=no-reply@birdtest.local

# Where confirmation and reset links point — the frontend dev server.
PUBLIC_URL=http://localhost:5173

# There is no DATA_PATH: letter distributions are read from the input_data row
# a job pins, never from disk.

HEARTBEAT_TIMEOUT_SECONDS=300

# Reverse proxies in front of this process that append X-Forwarded-For. 0 when
# running directly on the host; 1 behind the compose Nginx or the ALB.
TRUSTED_PROXY_HOPS=0

# MinIO stands in for S3 locally; the AWS SDK works against it unmodified.
S3_BUCKET=birdtest-artifacts
S3_ENDPOINT=http://localhost:9000
AWS_ACCESS_KEY_ID=birdtest
AWS_SECRET_ACCESS_KEY=birdtestbirdtest
AWS_REGION=us-east-1

# The oldest MAGPIE allowed to contribute at all. Individual jobs can require
# newer via their own min_magpie_version. `birdtest-contribute` reports 0.5.1,
# the first version that switches a word info table off for every task (0.5.0,
# the first to check a wordmap or rack info table against the hash the job
# pins, left a contributor's own table in force). The backend's own pinned
# MAGPIE (MAGPIE_BIN) must report at least this, or it refuses to start.
MIN_MAGPIE_VERSION=0.5.1
# The MAGPIE the server itself runs, for every derived file and every
# leave-generation KLV. A local checkout's build, when running on the host.
MAGPIE_BIN=../../MAGPIE/bin/magpie
MAGPIE_THREADS=1
MAGPIE_DOWNLOAD_URL=https://github.com/jvc56/MAGPIE

RUST_LOG=birdtest=debug,tower_http=debug
