# Copy to `.env` to override any of the compose defaults. Docker Compose reads
# `.env` from this directory automatically; nothing here is needed for a
# default `docker compose up`.

# Host ports. Change these if something already holds one of them.
# WEB_PORT=5173              # the site
# BACKEND_PORT=8080          # the API, exposed directly for debugging
# POSTGRES_PORT=5432
# MINIO_PORT=9000
# MINIO_CONSOLE_PORT=9001
# DEV_PORT=5174              # Vite dev server, `--profile dev`

# RUST_LOG=birdtest=debug,tower_http=info

# The fleet-wide MAGPIE version floor. `birdtest-contribute` reports 0.1.0,
# its pre-release version, which meets the default; scripts/dev.py reads the
# version out of your checkout and sets this for you.
# MIN_MAGPIE_VERSION=0.1.0

# Your MAGPIE checkout, mounted read-only into the backend so it can run
# `bin/magpie`. The backend builds every wordmap, rack info table and
# leave-generation KLV with it and refuses to start without one, so build it
# first: `make magpie BUILD=portable_release`. scripts/dev.py sets this from
# whatever --magpie you gave it.
# MAGPIE_ROOT=../MAGPIE

# `--profile fake-worker` knobs — the end-to-end suite's, not local development's.
# FAKE_MODE is normal | malformed | stale | abandon.
# FAKE_WORKERS=2
# FAKE_TASKS=0            # 0 runs until stopped
# FAKE_P1_WIN_RATE=0.5    # bias player 1 to drive SPRT to a chosen verdict
# FAKE_MODE=normal
