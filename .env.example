# Copy to `.env` to override any of the compose defaults. Docker Compose reads
# `.env` from this directory automatically; nothing here is needed for a
# default `docker compose up`.

# Host ports. Change these if something already holds one of them.
# WEB_PORT=5173              # the site
# BACKEND_PORT=8080          # the API, exposed directly for debugging
# POSTGRES_PORT=5432
# MINIO_PORT=9000
# MINIO_CONSOLE_PORT=9001
# DEV_PORT=5174              # Vite dev server, `--profile dev`

# MAGPIE is compiled from source into the images; there is no host checkout.
# These pin what gets built, and they are independent — changing one does not
# rebuild the other.
# MAGPIE_REF=d513d35020d2e87b83bfa68880f23d7921c660a7
# MAGPIE_DATA_VERSION=20251004

# Attribute the containerized worker's results to an account instead of an
# anonymous UUID. Generate one at /account.
# BIRDTEST_API_KEY=bt_...

# RUST_LOG=birdtest=debug,tower_http=info

# `--profile fake-worker` knobs. FAKE_MODE is normal | malformed | stale | abandon.
# FAKE_WORKERS=2
# FAKE_TASKS=0            # 0 runs until stopped
# FAKE_P1_WIN_RATE=0.5    # bias player 1 to drive SPRT to a chosen verdict
# FAKE_MODE=normal
